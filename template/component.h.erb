#pragma once

#include "utarray.h"
#include "uthash.h"
#include <babeltrace2/babeltrace.h>
#include <stdbool.h>
<% if options.key?(:'usr-data-header') %>
#include "<%= options[:'usr-data-header'] %>"
<% end %>

#ifdef __cplusplus
extern "C" {
#endif

// Forward declaration of common_data
struct common_data_s;
typedef struct common_data_s common_data_t;

// Params
// Avoid icx error: empty struct has size 0 in C, size 1 in C++
// [-Werror,-Wextern-c-compat]
struct btx_params_s {
  <% if params_declaration %>
  <%= params_declaration %>
  <% else %>
  char _dummy;
  <% end %>

}; <%# Need empty line for nice code gen %>
typedef struct btx_params_s btx_params_t;

void btx_populate_params(common_data_t *common_data_t);

struct callbacks_s {
  <% callback_types.each do |c| %>
  UT_array *<%= c %>;
  <% end %>
};
typedef struct callbacks_s callbacks_t;

<%# Forward Declaration %>
struct static_callbacks_s;
typedef struct static_callbacks_s static_callbacks_t;

struct name_to_dispatcher_s {
  const char *name;
  void *dispatcher;
  callbacks_t *callbacks;
  UT_hash_handle hh;
};
typedef struct name_to_dispatcher_s name_to_dispatcher_t;

<% if ['FILTER', 'SINK'].include?(options[:'component-type']) %>
/* Cache of the dispatcher of each upstream event class, so that the dispatcher is
 * looked up by name once per class, not once per event. `dispatcher` is NULL when
 * no callback is registered for the class. The entry holds a reference on the
 * event class: its address can't be reused by another class while it is cached. */
struct event_class_to_dispatcher_s {
  const bt_event_class *event_class;
  name_to_dispatcher_t *dispatcher;
  UT_hash_handle hh;
};
typedef struct event_class_to_dispatcher_s event_class_to_dispatcher_t;

/* Cache of the trace environment entries the dispatchers read (e.g. hostname),
 * so that an entry is looked up by name once per trace, not once per event. A
 * trace is frozen once it has a stream, so its environment can't change after
 * its first event. The entry holds a reference on the trace: its address can't
 * be reused by another trace while it is cached. `name` is the generated
 * code's string literal. */
struct trace_environment_key_s {
  const bt_trace *trace;
  const char *name;
};
struct trace_environment_entry_s {
  struct trace_environment_key_s key;
  const bt_value *value;
  UT_hash_handle hh;
};
typedef struct trace_environment_entry_s trace_environment_entry_t;
<% end %>

<% if ['SOURCE', 'FILTER'].include?(options[:'component-type']) %>
// One downstream trace (see btx_downstream_add_trace())
struct btx_downstream_trace {
  bt_trace *trace;
  /* Event classes, by downstream event index */
  bt_event_class **event_classes;
  /* Current packet of each stream, indexed like the streams */
  bt_packet **packets;
};

// Downstream message queue: a growable ring buffer
struct btx_message_queue {
  const bt_message **messages; /* `capacity` slots */
  uint64_t capacity;           /* 0 or a power of two */
  uint64_t head;               /* index of the first message */
  uint64_t len;                /* number of messages */
};

<% end %>
// Struct stored in the component via `bt_self_component_set_data`
<% if options[:'component-type'] == 'SOURCE' %>
struct common_data_s {
  name_to_dispatcher_t *name_to_dispatcher;
  static_callbacks_t *static_callbacks;
  <% if options[:'enable-additional-callbacks'].include?('downstream_message') %>
  void *downstream_message_callback;
  <% end %>
  void *usr_data;
  const bt_value *params;
  btx_params_t *btx_params;
  bt_trace *downstream_trace;
  /* Downstream event classes, by downstream event index (set by
   * btx_downstream_streams_create_rec()) */
  bt_event_class **downstream_event_classes;
  /* Current packet of each downstream stream, indexed like the streams
   * (NULL for streams whose class doesn't support packets) */
  bt_packet **downstream_packets;
  /* All the downstream traces: downstream_trace, downstream_event_classes,
   * and downstream_packets above are those of the current one
   * (btx_downstream_select_trace()) */
  struct btx_downstream_trace *downstream_traces;
  uint64_t downstream_trace_count;
  uint64_t downstream_trace_index;
  /* To create more downstream traces (btx_downstream_add_trace()) */
  bt_self_component *downstream_self_component;
  /* Used by downstream.c */
  bt_self_message_iterator *self_message_iterator;
};

enum btx_source_state_e {
  BTX_SOURCE_STATE_INITIALIZING,
  BTX_SOURCE_STATE_PROCESSING,
  BTX_SOURCE_STATE_FINALIZING,
  BTX_SOURCE_STATE_FINISHED,
  BTX_SOURCE_STATE_ERROR,
};
typedef enum btx_source_state_e btx_source_state_t;

/* Message iterator's private data */
struct btx_message_iterator_s {
  /* (Weak) link to the component's private data */
  common_data_t *common_data;
  btx_source_state_t state;

  /* Downstream message queue */
  struct btx_message_queue queue;
};
typedef struct btx_message_iterator_s btx_message_iterator_t;

enum btx_source_status_e {
  BTX_SOURCE_END,
  BTX_SOURCE_OK,
};
typedef enum btx_source_status_e btx_source_status_t;

<% elsif options[:'component-type'] == 'FILTER' %>
struct common_data_s {
  name_to_dispatcher_t *name_to_dispatcher;
  event_class_to_dispatcher_t *event_class_to_dispatcher;
  trace_environment_entry_t *trace_environment_entries;
  /* Last entry found (fast path: same trace and name as the previous lookup) */
  trace_environment_entry_t *trace_environment_last;
  static_callbacks_t *static_callbacks;
  <% if options[:'enable-additional-callbacks'].include?('downstream_message') %>
  void *downstream_message_callback;
  <% end %>
  <% if options[:'enable-additional-callbacks'].include?('upstream_event_fallback') %>
  void *upstream_event_fallback_callback;
  <% end %>

  void *usr_data;
  const bt_value *params;
  btx_params_t *btx_params;
  /* Component's input port (weak) */
  const bt_component_filter *component;
  bt_trace *downstream_trace;
  /* Downstream event classes, by downstream event index (set by
   * btx_downstream_streams_create_rec()) */
  bt_event_class **downstream_event_classes;
  /* Current packet of each downstream stream, indexed like the streams
   * (NULL for streams whose class doesn't support packets) */
  bt_packet **downstream_packets;
  /* All the downstream traces: downstream_trace, downstream_event_classes,
   * and downstream_packets above are those of the current one
   * (btx_downstream_select_trace()) */
  struct btx_downstream_trace *downstream_traces;
  uint64_t downstream_trace_count;
  uint64_t downstream_trace_index;
  /* To create more downstream traces (btx_downstream_add_trace()) */
  bt_self_component *downstream_self_component;
  /* Used by downstream.c */
  bt_self_message_iterator *self_message_iterator;
};

enum btx_filter_state_e {
  BTX_FILTER_STATE_INITIALIZING,
  BTX_FILTER_STATE_PROCESSING,
  BTX_FILTER_STATE_FINALIZING,
  BTX_FILTER_STATE_FINISHED,
  BTX_FILTER_STATE_ERROR,
};
typedef enum btx_filter_state_e btx_filter_state_t;

enum btx_filter_processing_state_e {
  BTX_FILTER_PROCESSING_STATE_READING,
  BTX_FILTER_PROCESSING_STATE_SENDING,
  BTX_FILTER_PROCESSING_STATE_FINISHED,
};
typedef enum btx_filter_processing_state_e btx_filter_processing_state_t;

typedef struct el_mi {
  /* Upstream message iterator (owned by this) */
  bt_message_iterator *message_iterator;
  struct el_mi *next, *prev;
} el_mi;

/* Message iterator's private data */
struct btx_message_iterator_s {
  /* (Weak) link to the component's private data */
  common_data_t *common_data;
  /*  Upstream messages iterator */
  el_mi *head_mi;
  btx_filter_state_t state;
  btx_filter_processing_state_t processing_state;
  /* Downstream message queue */
  struct btx_message_queue queue;
};
typedef struct btx_message_iterator_s btx_message_iterator_t;

<% elsif options[:'component-type'] == 'SINK' %>
struct common_data_s {
  name_to_dispatcher_t *name_to_dispatcher;
  event_class_to_dispatcher_t *event_class_to_dispatcher;
  trace_environment_entry_t *trace_environment_entries;
  /* Last entry found (fast path: same trace and name as the previous lookup) */
  trace_environment_entry_t *trace_environment_last;
  static_callbacks_t *static_callbacks;

  void *usr_data;
  const bt_value *params;
  btx_params_t *btx_params;
  /* Upstream message iterator (owned by this) */
  bt_message_iterator *message_iterator;
  <% if options[:'enable-additional-callbacks'].include?('upstream_event_fallback') %>
  void *upstream_event_fallback_callback;
  <% end %>
};
<% end %>

void btx_register_usr_callbacks(void *btx_handle);
void btx_unregister_callbacks(common_data_t *common_data);
<% if ['FILTER', 'SINK'].include?(options[:'component-type']) %>
/* Empty the event class -> dispatcher cache, putting the event class references */
void btx_flush_dispatcher_cache(common_data_t *common_data);
/* Empty the trace environment cache, putting the trace references */
void btx_flush_environment_cache(common_data_t *common_data);
<% end %>

<% static_callback_types.each do |e| %>
typedef void <%= e.name_sanitized %>_static_callback_f(
    <%= "void *btx_handle," unless e.no_btx_handle %>
        <%= e.args.map{ |s| s.type }.join(", ") %>);

<%# The Function who register the callbacks to the dispatcher %>
void btx_register_callbacks_<%= e.name_sanitized %>(
    void *btx_handle, <%= e.name_sanitized %>_static_callback_f *callback);

void btx_call_callbacks_<%= e.name_sanitized %>(
    common_data_t *common_data, <%= e.args.map{ |s| s.type }.join(", ") %>);
<% end %>

struct static_callbacks_s {
  <% static_callback_types.each do |e| %>
  <%= e.name_sanitized %>_static_callback_f *<%= e.name_sanitized %>;
  <% end %>
};

#ifdef __cplusplus
}
#endif
