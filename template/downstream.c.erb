#include "utlist.h"
#include <babeltrace2/babeltrace.h>
#include <metababel/btx_component.h>
#include <metababel/btx_downstream.h>
#include <stdlib.h>

void btx_downstream_move_messages(
    btx_message_iterator_t *message_iterator_private_data,
    bt_message_array_const messages, uint64_t capacity, uint64_t *count) {

  /* Move min(capacity, queue length) messages from the head of the queue */
  struct btx_message_queue *q = &message_iterator_private_data->queue;
  const uint64_t n = q->len < capacity ? q->len : capacity;
  for (uint64_t i = 0; i < n; i++)
    messages[i] = q->messages[(q->head + i) & (q->capacity - 1)];
  if (n) {
    q->head = (q->head + n) & (q->capacity - 1);
    q->len -= n;
  }
  *count = n;
}

// btx_handle is the component (common_data_t); find its message iterator
static inline btx_message_iterator_t *__attribute__((unused))
_btx_message_iterator(void *btx_handle) {
  return (btx_message_iterator_t *)bt_self_message_iterator_get_data(
      ((common_data_t *)btx_handle)->self_message_iterator);
}

static inline void
_btx_push_message(btx_message_iterator_t *message_iterator_private_data,
                  const bt_message *message) {

  struct btx_message_queue *q = &message_iterator_private_data->queue;
  if (q->len == q->capacity) {
    /* Full: double the capacity, keeping the order */
    const uint64_t capacity = q->capacity ? 2 * q->capacity : 64;
    const bt_message **messages =
        (const bt_message **)malloc(capacity * sizeof(*messages));
    for (uint64_t i = 0; i < q->len; i++)
      messages[i] = q->messages[(q->head + i) & (q->capacity - 1)];
    free(q->messages);
    q->messages = messages;
    q->capacity = capacity;
    q->head = 0;
  }
  q->messages[(q->head + q->len) & (q->capacity - 1)] = message;
  q->len++;
}

<% if options[:'enable-additional-callbacks'].include?('downstream_message') %>
void btx_direct_push_message(void *btx_handle, const bt_message *message) {
  /* The callback borrows the message: the queue takes its own reference */
  bt_message_get_ref(message);
  _btx_push_message(_btx_message_iterator(btx_handle), message);
}

void btx_register_callback_downstream_message(
    void *btx_handle, downstream_message_callback_f *callback) {
  ((common_data_t *)btx_handle)->downstream_message_callback = (void *)callback;
}
<% end %>
// Used internally to push messages downstreams. Takes the reference of message.
void btx_downstream_push_message(
    btx_message_iterator_t *message_iterator_private_data,
    const bt_message *message) {

  <% if options[:'enable-additional-callbacks'].include?('downstream_message') %>
  downstream_message_callback_f *p =
      (downstream_message_callback_f *)message_iterator_private_data
          ->common_data->downstream_message_callback;
  if (p) {
    /* The callback borrows the message */
    p(message_iterator_private_data->common_data,
      message_iterator_private_data->common_data->usr_data, message);
    bt_message_put_ref(message);
    return;
  }
  <% end %>
  _btx_push_message(message_iterator_private_data, message);
}

<% if options[:'enable-additional-callbacks'].include?('upstream_event_fallback') %>
void btx_push_message(void *btx_handle, const bt_message *message) {
  /* The callback borrows the message: take a reference to send it */
  bt_message_get_ref(message);
  btx_downstream_push_message(_btx_message_iterator(btx_handle), message);
}
<% end %>

// Register callbacks
bt_trace_class *
btx_downstream_trace_class_create_rec(bt_self_component *_self_component) {
  bt_trace_class *_trace_class;
  <%= body_declarator_classes %>
  return _trace_class;
}

bt_trace *btx_downstream_trace_create_rec(bt_trace_class *trace_class) {
  return bt_trace_create(trace_class);
}

void btx_downstream_streams_create_rec(common_data_t *common_data) {
  bt_trace *trace = common_data->downstream_trace;
  bt_trace_class *trace_class = bt_trace_borrow_class(trace);

  /* Cache the event classes: btx_push_message_<event>() uses them */
  common_data->downstream_event_classes = (bt_event_class **)calloc(
      <%= downstream_events.size + 1 %>, sizeof(bt_event_class *));
  <% downstream_events.each_with_index do |e, ei| %>
  common_data->downstream_event_classes[<%= ei %>] =
      bt_stream_class_borrow_event_class_by_index(
          bt_trace_class_borrow_stream_class_by_index(trace_class,
                                                      <%= e.index_stream_class %>),
          <%= e.index_event_class %>);
  <% end %>
  <% stream_classes.each_with_index do |_,i| %>
  {
    bt_stream_class *stream_class =
        bt_trace_class_borrow_stream_class_by_index(trace_class, <%= i %>);
    bt_stream_put_ref(bt_stream_create(stream_class, trace));
  }
  <% end %>
  (void)trace_class;
}

// Workaround of a bug where gepping trace alive (and not the stream) provoke
// some segfault
void btx_streams_get_ref(bt_trace *trace) {
  <% stream_classes.each_with_index do |_,i| %>
  {
    bt_stream *stream = bt_trace_borrow_stream_by_index(trace, <%= i %>);
    bt_stream_get_ref(stream);
  }
  <% end %>
}

void btx_streams_put_ref(bt_trace *trace) {
  <% stream_classes.each_with_index do |_,i| %>
  {
    bt_stream *stream = bt_trace_borrow_stream_by_index(trace, <%= i %>);
    bt_stream_put_ref(stream);
  }
  <% end %>
}

void btx_push_messages_stream_beginning(
    bt_self_message_iterator *self_message_iterator,
    btx_message_iterator_t *message_iterator_private_data) {

  common_data_t *common_data = message_iterator_private_data->common_data;
  bt_trace *trace = common_data->downstream_trace;
  <% if stream_classes.any?(&:packet_context_field_class) %>
  common_data->downstream_packets =
      (bt_packet **)calloc(<%= stream_classes.size %>, sizeof(bt_packet *));
  <% end %>
  <% stream_classes.each_with_index do |s,i| %>
  {
    bt_stream *stream = bt_trace_borrow_stream_by_index(trace, <%= i %>);
    bt_message *message =
        bt_message_stream_beginning_create(self_message_iterator, stream);
    btx_downstream_push_message(message_iterator_private_data, message);
    <% if s.packet_context_field_class %>
    /* The stream class supports packets: all the events of this stream go
     * in a single packet, opened right after the stream beginning. Its
     * context fields keep their default values. */
    bt_packet *packet = bt_packet_create(stream);
    common_data->downstream_packets[<%= i %>] = packet;
    btx_downstream_push_message(
        message_iterator_private_data,
        bt_message_packet_beginning_create(self_message_iterator, packet));
    <% end %>
  }
  <% end %>
  (void)common_data;
  (void)trace;
}

void btx_push_messages_stream_end(
    bt_self_message_iterator *self_message_iterator,
    btx_message_iterator_t *message_iterator_private_data) {

  common_data_t *common_data = message_iterator_private_data->common_data;
  bt_trace *trace = common_data->downstream_trace;
  <% stream_classes.each_with_index do |s,i| %>
  {
    bt_stream *stream = bt_trace_borrow_stream_by_index(trace, <%= i %>);
    <% if s.packet_context_field_class %>
    /* Close the stream's packet before ending the stream */
    bt_packet *packet = common_data->downstream_packets[<%= i %>];
    btx_downstream_push_message(
        message_iterator_private_data,
        bt_message_packet_end_create(self_message_iterator, packet));
    bt_packet_put_ref(packet);
    common_data->downstream_packets[<%= i %>] = NULL;
    <% end %>
    bt_message *message =
        bt_message_stream_end_create(self_message_iterator, stream);
    btx_downstream_push_message(message_iterator_private_data, message);
  }
  <% end %>
  <% if stream_classes.any?(&:packet_context_field_class) %>
  free(common_data->downstream_packets);
  common_data->downstream_packets = NULL;
  <% end %>
  (void)common_data;
  (void)trace;
}

<% downstream_events.each_with_index do |e, ei| %>
static void btx_set_message_<%= e.name_sanitized %>(
    bt_event *
        <%= event_name %><%= e.args.map{ |s| "#{s.type} #{s.name}" }.join_with_prefix(", ") %>) {
  <%= e.body %>
}

void btx_push_message_<%= e.name_sanitized %>(
    void *
        btx_handle<%= e.args.map{ |s| "#{s.type} #{s.name}" }.join_with_prefix(", ") %>) {

  common_data_t *common_data = (common_data_t *)btx_handle;

  bt_event_class *_event_class = common_data->downstream_event_classes[<%= ei %>];
  <% if stream_classes[e.index_stream_class].packet_context_field_class %>
  /* The stream class supports packets: the event must belong to one */
  bt_packet *_packet =
      common_data->downstream_packets[<%= e.index_stream_class %>];
  <% if !e.default_clock_class %>
  bt_message *_message = bt_message_event_create_with_packet(
      common_data->self_message_iterator, _event_class, _packet);
  <% else %>
  bt_message *_message =
      bt_message_event_create_with_packet_and_default_clock_snapshot(
          common_data->self_message_iterator, _event_class, _packet,
          _timestamp);
  <% end %>
  <% else %>
  bt_stream *_stream = bt_trace_borrow_stream_by_index(
      common_data->downstream_trace, <%= e.index_stream_class %>);
  <% if !e.default_clock_class %>
  bt_message *_message = bt_message_event_create(
      common_data->self_message_iterator, _event_class, _stream);
  <% else %>
  bt_message *_message = bt_message_event_create_with_default_clock_snapshot(
      common_data->self_message_iterator, _event_class, _stream, _timestamp);
  <% end %>
  <% end %>

  bt_event *_downstream_event = bt_message_event_borrow_event(_message);

  btx_set_message_<%= e.name_sanitized %>(
      _downstream_event<%= e.args.map{ |s| s.name }.join_with_prefix(", ") %>);

  btx_downstream_push_message(_btx_message_iterator(btx_handle), _message);
}
<% end %>

<% downstream_environements.each do |arg, body| %>
void btx_downstream_set_environment_<%= arg.name%>(
    void *btx_handle, <%= arg.type%> <%= arg.name%>) {
  common_data_t *common_data = (common_data_t *)btx_handle;
  bt_trace *_trace = common_data->downstream_trace;
  <%= body %>
}
<% end %>

<% downstream_clock_classes.each do |i, sc| %>
bt_clock_class *btx_downstream_default_clock_class_<%= sc %>(void *btx_handle) {
  common_data_t *common_data = (common_data_t *)btx_handle;
  bt_stream_class *stream_class = bt_trace_class_borrow_stream_class_by_index(
      bt_trace_borrow_class(common_data->downstream_trace), <%= i %>);
  return bt_stream_class_borrow_default_clock_class(stream_class);
}
<% end %>

<% downstream_packets.each do |i, sc, args, body| %>
void btx_downstream_new_packet_<%= sc %>(
    void *btx_handle<%= args.map{ |s| "#{s.type} #{s.name}" }.join_with_prefix(", ") %>) {
  common_data_t *common_data = (common_data_t *)btx_handle;
  btx_message_iterator_t *message_iterator_private_data =
      _btx_message_iterator(btx_handle);
  bt_packet *old_packet = common_data->downstream_packets[<%= i %>];

  /* End the current packet */
  if (old_packet) {
    btx_downstream_push_message(
        message_iterator_private_data,
        bt_message_packet_end_create(common_data->self_message_iterator,
                                     old_packet));
    bt_packet_put_ref(old_packet);
  }

  /* Begin the new one */
  bt_packet *packet = bt_packet_create(
      bt_trace_borrow_stream_by_index(common_data->downstream_trace, <%= i %>));
  bt_field *_pc_field = bt_packet_borrow_context_field(packet);
  <%= body %>
  common_data->downstream_packets[<%= i %>] = packet;
  btx_downstream_push_message(
      message_iterator_private_data,
      bt_message_packet_beginning_create(common_data->self_message_iterator,
                                         packet));
}
<% end %>
