#pragma once
#include <metababel/btx_component.h>
#ifdef __cplusplus
extern "C" {
#endif

// Dispatcher
typedef void(dispatcher_t)(callbacks_t *callbacks, common_data_t *common_data,
                           const bt_message *upstream_message);

<%# The Function who register the callbacks to the dispatcher %>
<% dispatch_types.each do |dispatch_type| %>
typedef void <%= dispatch_type.name_sanitized %>_callback_f(
    void *btx_handle,
    void *
        usr_data<%= dispatch_type.args.values[0].map{ |s| s.type }.join_with_prefix(', ') %>);

void btx_register_callbacks_<%= dispatch_type.name_sanitized %>(
    void *btx_handle, <%= dispatch_type.name_sanitized %>_callback_f *callback);

<% end %>
void btx_unregister_callbacks(common_data_t *common_data);

/* The value of a trace environment entry, NULL if the trace has no such entry */
static inline const bt_value *
btx_borrow_environment_entry_value(common_data_t *common_data,
                                   const bt_trace *trace, const char *name) {
  /* Fast path: usually the same trace and entry as the previous lookup */
  trace_environment_entry_t *last = common_data->trace_environment_last;
  if (last && last->key.trace == trace && last->key.name == name)
    return last->value;

  struct trace_environment_key_s key;
  memset(&key, 0, sizeof(key));
  key.trace = trace;
  key.name = name;
  trace_environment_entry_t *e = NULL;
  HASH_FIND(hh, common_data->trace_environment_entries, &key, sizeof(key), e);
  if (!e) {
    /* First event of this trace: look the entry up by name, once */
    e = (trace_environment_entry_t *)malloc(sizeof(*e));
    e->key = key;
    e->value = bt_trace_borrow_environment_entry_value_by_name_const(trace, name);
    bt_trace_get_ref(trace);
    HASH_ADD(hh, common_data->trace_environment_entries, key, sizeof(key), e);
  }
  common_data->trace_environment_last = e;
  return e->value;
}

/* The dispatcher of an upstream event class, NULL if no callback is registered for it */
static inline name_to_dispatcher_t *
btx_lookup_dispatcher(common_data_t *common_data,
                      const bt_event_class *event_class) {
  event_class_to_dispatcher_t *e = NULL;
  HASH_FIND_PTR(common_data->event_class_to_dispatcher, &event_class, e);
  if (!e) {
    /* First event of this class: look its dispatcher up by name, once */
    e = (event_class_to_dispatcher_t *)malloc(sizeof(*e));
    e->event_class = event_class;
    e->dispatcher = NULL;
    const char *class_name = bt_event_class_get_name(event_class);
    if (class_name)
      HASH_FIND_STR(common_data->name_to_dispatcher, class_name, e->dispatcher);
    bt_event_class_get_ref(event_class);
    HASH_ADD_PTR(common_data->event_class_to_dispatcher, event_class, e);
  }
  return e->dispatcher;
}

#ifdef __cplusplus
}
#endif
