#pragma once
#include <metababel/btx_component.h>
#ifdef __cplusplus
extern "C" {
#endif

// Dispatcher
typedef void(dispatcher_t)(callbacks_t *callbacks, common_data_t *common_data,
                           const bt_message *upstream_message);

<%# The Function who register the callbacks to the dispatcher %>
<% dispatch_types.each do |dispatch_type| %>
typedef void <%= dispatch_type.name_sanitized %>_callback_f(
    void *btx_handle,
    void *
        usr_data<%= dispatch_type.args.values[0].map{ |s| s.type }.join_with_prefix(', ') %>);

void btx_register_callbacks_<%= dispatch_type.name_sanitized %>(
    void *btx_handle, <%= dispatch_type.name_sanitized %>_callback_f *callback);

<% end %>
void btx_unregister_callbacks(common_data_t *common_data);

<% if options[:'upstream-event-fallback'] == 'callback' %>
/* Called with every upstream event no callback above is registered for.
<% if options[:'component-type'] == 'FILTER' %>
 * The callback owns the message: it sends it downstream with
 * btx_forward_message, or puts its reference. */
<% else %>
 * The message is borrowed: the sink puts its reference afterwards. */
<% end %>
typedef void upstream_event_fallback_callback_f(void *btx_handle,
                                                void *usr_data,
                                                const bt_message *message);
void btx_register_callbacks_upstream_event_fallback(
    void *btx_handle, upstream_event_fallback_callback_f *callback);
<% end %>

#ifdef __cplusplus
}
#endif
