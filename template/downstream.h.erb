#pragma once
#include <babeltrace2/babeltrace.h>
#include <metababel/btx_component.h>
#ifdef __cplusplus
extern "C" {
#endif
void btx_downstream_move_messages(
    btx_message_iterator_t *message_iterator_private_data,
    bt_message_array_const messages, uint64_t capacity, uint64_t *count);

void btx_downstream_push_message(
    btx_message_iterator_t *message_iterator_private_data,
    const bt_message *message);

bt_trace_class *
btx_downstream_trace_class_create_rec(bt_self_component *self_component);

bt_trace *btx_downstream_trace_create_rec(bt_trace_class *trace_class);

/* Creates the streams of `trace` (one per stream class): after the user
 * initialization callbacks, which may still configure the classes. */
void btx_downstream_streams_create_rec(common_data_t *common_data);

void btx_streams_get_ref(bt_trace *trace);
void btx_streams_put_ref(bt_trace *trace);

void btx_push_messages_stream_beginning(
    bt_self_message_iterator *self_message_iterator,
    btx_message_iterator_t *message_iterator_private_data);
void btx_push_messages_stream_end(
    bt_self_message_iterator *self_message_iterator,
    btx_message_iterator_t *message_iterator_private_data);

<% downstream_events.each do |e| %>
void btx_push_message_<%= e.name_sanitized %>(
    void *
        btx_handle<%= e.args.map{ |s| "#{s.type} #{s.name}" }.join_with_prefix(", ") %>);
<% end %>

<% if options[:'enable-additional-callbacks'].include?('upstream_event_fallback') %>
/* Send downstream a message the upstream event fallback callback borrows, like
 * btx_push_message_<event>: through the downstream message callback, if any.
 * Takes its own reference: the caller keeps its own, if any. */
void btx_push_message(void *btx_handle, const bt_message *message);
<% end %>

<% if options[:'enable-additional-callbacks'].include?('downstream_message') %>
/* Called with every message the component sends downstream. The message is
 * borrowed: metababel puts its reference afterwards. To let it through, use
 * btx_direct_push_message; otherwise it is dropped. To keep it after the
 * callback returns, take a reference (bt_message_get_ref). What it sends with
 * btx_push_message or btx_push_message_<event> comes back to it. */
typedef void downstream_message_callback_f(void *btx_handle, void *usr_data,
                                           const bt_message *message);
void btx_register_callback_downstream_message(
    void *btx_handle, downstream_message_callback_f *callback);
/* Put a message in the output queue, without calling the downstream message
 * callback. Takes its own reference: the caller keeps its own, if any. */
void btx_direct_push_message(void *btx_handle, const bt_message *message);
<% end %>

<% downstream_environements.each do |arg, body| %>
void btx_downstream_set_environment_<%= arg.name%>(
    void *btx_handle, <%= arg.type%> <%= arg.name%>);
<% end %>

<% downstream_clock_classes.each do |i, sc| %>
/* Default clock class of the stream class `<%= sc %>`, to configure (name,
 * frequency, offset, origin...) in the configure_downstream callback only: it
 * is frozen once the streams exist. */
bt_clock_class *btx_downstream_default_clock_class_<%= sc %>(void *btx_handle);
<% end %>

<% downstream_packets.each do |i, sc, args, body| %>
/* Ends the current packet of the stream of the stream class `<%= sc %>` and
 * begins a new one, of which the context fields get the values of the
 * arguments. The following events of this stream belong to the new packet. */
void btx_downstream_new_packet_<%= sc %>(
    void *btx_handle<%= args.map{ |s| "#{s.type} #{s.name}" }.join_with_prefix(", ") %>);
<% end %>

#ifdef __cplusplus
}
#endif
